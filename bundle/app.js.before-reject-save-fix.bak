import { AnnaAppRuntime } from "/static/anna-apps/_sdk/latest/index.js";

const STORAGE_KEY = "caseflow:cases";

const INITIAL_STATE = "NEW";

const TRANSITION_FIELDS = [
  "state",
  "blocker",
  "nextAction",
  "reason"
];

const state = {
  anna: null,
  cases: [],
  currentView: "dashboard",
  activeCaseId: null,
  pendingTransition: null,
  busy: false
};

const $ = (id) => document.getElementById(id);

function escapeHtml(value) {
  return String(value ?? "").replace(/[&<>"']/g, (character) => {
    const entities = {
      "&": "&amp;",
      "<": "&lt;",
      ">": "&gt;",
      '"': "&quot;",
      "'": "&#39;"
    };

    return entities[character];
  });
}

function formatDate(value) {
  if (!value) return "Not recorded";

  const date = new Date(value);

  if (Number.isNaN(date.getTime())) return "Not recorded";

  return date.toLocaleDateString(undefined, {
    year: "numeric",
    month: "short",
    day: "numeric"
  });
}

function formatDateTime(value) {
  if (!value) return "Not recorded";

  const date = new Date(value);

  if (Number.isNaN(date.getTime())) return "Not recorded";

  return date.toLocaleString(undefined, {
    year: "numeric",
    month: "short",
    day: "numeric",
    hour: "2-digit",
    minute: "2-digit"
  });
}

function getCurrentCase() {
  return state.cases.find(
    (item) => item.id === state.activeCaseId
  ) ?? null;
}

function setRuntimeState(message, status = "ready") {
  const statusElement = $("status");
  const runtimeLabel = $("runtime-label");
  const statusDot = $("status-dot");

  if (statusElement) {
    statusElement.textContent = message;
  }

  if (runtimeLabel) {
    runtimeLabel.textContent =
      status === "connected"
        ? "Anna AI connected"
        : status === "error"
          ? "Local mode"
          : status === "working"
            ? "Processing"
            : "CASEFLOW";
  }

  if (statusDot) {
    statusDot.dataset.status = status;
  }
}

function saveCases() {
  try {
    localStorage.setItem(
      STORAGE_KEY,
      JSON.stringify(state.cases)
    );

    return true;
  } catch (error) {
    console.error("CASEFLOW: Could not save cases.", error);
    setRuntimeState(
      "Could not save changes in this browser.",
      "error"
    );
    return false;
  }
}

function loadCases() {
  try {
    const stored = localStorage.getItem(STORAGE_KEY);

    if (!stored) {
      state.cases = [];
      return;
    }

    const parsed = JSON.parse(stored);

    state.cases = Array.isArray(parsed)
      ? parsed.filter(
          (item) =>
            item &&
            typeof item.id === "string" &&
            typeof item.title === "string"
        )
      : [];
  } catch (error) {
    console.error("CASEFLOW: Could not load saved cases.", error);
    state.cases = [];
    setRuntimeState(
      "Saved data could not be read. Starting with an empty list.",
      "error"
    );
  }
}

