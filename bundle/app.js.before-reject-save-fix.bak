    .cf-stat-label {
      color: var(--muted, #929bad);
      font-size: 12px;
      line-height: 1.5;
    }

    .cf-stat-number {
      margin-top: 8px;
      font-size: 27px;
      font-weight: 800;
    }

    .cf-section-heading {
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 12px;
      margin: 28px 0 14px;
    }

    .cf-section-heading h2 {
      margin: 0;
      font-size: 17px;
      font-weight: 750;
    }

    .cf-muted {
      color: var(--muted, #929bad);
      font-size: 12px;
      line-height: 1.65;
    }

    .cf-case-list {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 14px;
    }

    .cf-case-card {
      display: flex;
