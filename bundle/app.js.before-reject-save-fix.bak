    }

    .cf-case-card h3 {
      margin: 0;
      font-size: 16px;
      line-height: 1.5;
      overflow-wrap: anywhere;
    }

    .cf-state {
      display: inline-flex;
      align-self: flex-start;
      max-width: 100%;
      padding: 5px 9px;
      border-radius: 999px;
      background: rgba(98, 85, 231, .14);
      color: #bdb6ff;
      font-size: 11px;
      font-weight: 800;
      overflow-wrap: anywhere;
    }

    .cf-detail-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 14px;
      margin: 20px 0;
    }

    .cf-detail-grid .cf-card {
      overflow-wrap: anywhere;
    }

    .cf-card h3 {
      margin: 0 0 12px;
      font-size: 14px;
    }

    .cf-card p {
      margin: 0;
      line-height: 1.7;
      overflow-wrap: anywhere;
