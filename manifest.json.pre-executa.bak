                                  "min_version":  "0.1.0",
                                  "version":  "latest"
                              }
                          ],
    "tags":  [
                 "caseflow"
             ],
    "ui":  {
               "bundle":  {
                              "format":  "static-spa",
                              "entry":  "index.html",
                              "external_origins":  [

                                                   ]
                          },
               "views":  [
                             {
                                 "name":  "main",
                                 "title":  "CASEFLOW",
                                 "default":  true,
                                 "default_size":  {
                                                      "w":  900,
                                                      "h":  700
                                                  },
