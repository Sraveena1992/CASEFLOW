                                                "set"
                                            ],
                                "window":  [
                                               "set_title",
                                               "ready"
                                           ]
                            },
               "csp_overrides":  {

                                 },
               "state_merge":  "last_writer_wins"
           },
    "dev":  {
                "fixtures":  [
